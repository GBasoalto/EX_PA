@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EcoMercado Austral</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/layout.css" />
</head>

<body>

    <!-- HEADER -->
    <header class="top-header d-flex align-items-center justify-content-between px-3">
        <div class="d-flex align-items-center">
            <img src="~/images/logo.jpeg" class="header-logo" />
            <h2 class="ms-3 app-title">EcoMercado Austral</h2>
        </div>

        <!-- USUARIO + DROPDOWN -->
        <div class="dropdown me-3">
            @if (HttpContextAccessor?.HttpContext?.Session?.GetInt32("UsuarioId") != null)
            {
                var nombre = HttpContextAccessor.HttpContext.Session.GetString("NombreCompleto");

                <a class="btn user-button dropdown-toggle" href="#" id="userDropdown" data-bs-toggle="dropdown">
                    @nombre
                </a>

                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" asp-controller="Login" asp-action="Logout">Cerrar sesión</a>
                    </li>
                </ul>
            }
        </div>
    </header>

    <!-- MAIN WRAPPER -->
    <div class="main-wrapper d-flex">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <ul class="menu">
                <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                <li><a asp-controller="Usuarios" asp-action="Index">Gestionar Usuarios</a></li>
                <li><a asp-controller="Clientes" asp-action="Index">Clientes</a></li>
                <li><a asp-controller="Ventas" asp-action="Index">Ventas</a></li>
                <li><a asp-controller="Reportes" asp-action="Index">Reportes</a></li>
            </ul>
        </aside>

        <!-- CONTENIDO -->
        <main class="content p-4">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="footer text-center">
        © 2025 EcoMercado Austral. Todos los derechos reservados.
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- SweetAlert para mensajes de éxito y errores -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var success = '@TempData["Success"]';
            var error = '@TempData["Error"]';

            if (success) {
                Swal.fire({
                    icon: 'success',
                    title: '¡Éxito!',
                    text: success,
                    timer: 2500,
                    timerProgressBar: true,
                    showConfirmButton: false
                });
            }

            if (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    html: error.replace(/\n/g, "<br/>"),
                    timer: 3000,
                    timerProgressBar: true
                });
            }
        });
    </script>

</body>
</html>
