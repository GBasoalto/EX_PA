@model GestionClientesEcoMercadoAustral.Models.Cliente

@{
    ViewData["Title"] = "Detalles del Cliente";
}

<h1 class="mb-4 fw-bold text-dark">Detalles del Cliente</h1>

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
        <h5 class="m-0">
            <i class="bi bi-person-vcard"></i> Información del Cliente
        </h5>
    </div>

    <div class="card-body">

        <table class="table table-striped table-borderless align-middle">
            <tbody>
                <tr>
                    <th class="fw-semibold text-dark" style="width: 25%;">RUT</th>
                    <td>@Model.Rut</td>
                </tr>

                <tr>
                    <th class="fw-semibold text-dark">Nombre</th>
                    <td>@Model.Nombre</td>
                </tr>

                <tr>
                    <th class="fw-semibold text-dark">Tipo Cliente</th>
                    <td>
                        @if (Model.TipoCliente == "Persona")
                        {
                            <span class="badge bg-info text-dark">Persona</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Empresa</span>
                        }
                    </td>
                </tr>

                @if (Model.TipoCliente == "Persona")
                {
                    <tr>
                        <th class="fw-semibold text-dark">Primer Apellido</th>
                        <td>@Model.Apellido1</td>
                    </tr>

                    <tr>
                        <th class="fw-semibold text-dark">Segundo Apellido</th>
                        <td>@Model.Apellido2</td>
                    </tr>
                }

                <tr>
                    <th class="fw-semibold text-dark">Dirección</th>
                    <td>@Model.Direccion</td>
                </tr>

                <tr>
                    <th class="fw-semibold text-dark">Comuna</th>
                    <td>@Model.Comuna?.Nombre</td>
                </tr>

                <tr>
                    <th class="fw-semibold text-dark">Región</th>
                    <td>@Model.Comuna?.Region?.Nombre</td>
                </tr>

                <tr>
                    <th class="fw-semibold text-dark">Registrado por</th>
                    <td>@Model.Usuario?.Nombre @Model.Usuario?.Apellido1 (@Model.Usuario?.Rut)</td>
                </tr>

                <tr>
                    <th class="fw-semibold text-dark">Segmento</th>
                    <td>@Model.SegmentoCliente?.NombreSegmento</td>
                </tr>
            </tbody>
        </table>

    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.ClienteId">
        <i class="bi bi-pencil-square"></i> Editar
    </a>

    <a class="btn btn-secondary" asp-action="Index">
        <i class="bi bi-arrow-left-circle"></i> Volver
    </a>
</div>
