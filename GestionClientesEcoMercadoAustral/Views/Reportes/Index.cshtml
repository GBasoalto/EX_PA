@model IEnumerable<ReporteComuna>

@{
    ViewData["Title"] = "Reporte por Comuna y Usuario";
}

<style>
    /* Arregla doble flecha en DataTables con Bootstrap */
    div.dataTables_length select {
        appearance: auto !important; /* usa solo la flecha nativa del navegador */
        -webkit-appearance: auto !important;
        -moz-appearance: auto !important;
        padding-right: 25px !important;
        min-width: 65px !important;
        height: 38px !important;
    }

    /* Evita que el contenedor parta el texto */
    div.dataTables_length {
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        /* Oculta flecha personalizada que agrega DataTables */
        div.dataTables_length select.form-select {
            background-image: none !important;
        }
</style>


<h2 class="mb-4">Reporte de Clientes por Comuna</h2>

<table id="tablaComunas" class="table table-striped table-bordered text-center align-middle">
    <thead class="table-dark">
        <tr>
            <th>Comuna</th>
            <th>Cantidad de Clientes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Comuna</td>
                <td>@item.Cantidad</td>
            </tr>
        }
    </tbody>
</table>

<hr class="my-5" />

<h2 class="mb-4">Clientes agregados por Usuario</h2>

<table id="tablaUsuarios" class="table table-striped table-bordered text-center align-middle">
    <thead class="table-primary">
        <tr>
            <th>Vendedor</th>
            <th>Cantidad de Clientes</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in (IEnumerable<ReporteUsuario>)ViewBag.ReporteUsuarios)
        {
            <tr>
                <td>@item.Usuario</td>
                <td>@item.Cantidad</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {

    <!-- JQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <script>
        $(document).ready(function () {

            $('#tablaComunas').DataTable({
                pageLength: 10,
                lengthMenu: [10, 20, 50, 100],
                language: {
                    url: "https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                }
            });

            $('#tablaUsuarios').DataTable({
                pageLength: 10,
                lengthMenu: [10, 20, 50, 100],
                language: {
                    url: "https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json"
                }
            });

        });
    </script>
}
