@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - Eco Mercado Austral</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <link href="~/css/login.css" rel="stylesheet" />
</head>
<body>

    <!-- Fondos deslizantes -->
    <div class="bg-slide" style="background-image: url('/images/loginfondo1.jpg');"></div>
    <div class="bg-slide" style="background-image: url('/images/loginfondo2.jpg');"></div>
    <div class="bg-slide" style="background-image: url('/images/loginfondo3.jpg');"></div>
    <div class="bg-slide" style="background-image: url('/images/loginfondo4.jpg');"></div>

    <!-- Card de login -->
    <div class="card login-card">
        <div class="text-center mb-4">
            <img src="~/images/logo.jpeg" alt="Logo Empresa" class="img-fluid login-logo" />
        </div>

        <h3 class="text-center mb-4">Iniciar Sesión</h3>

        <form id="loginForm">
            @Html.AntiForgeryToken() <!-- Agregar token CSRF -->
            <div class="mb-3">
                <input name="username" class="form-control" placeholder="Usuario" required />
            </div>
            <div class="mb-3">
                <input name="password" type="password" class="form-control" placeholder="Contraseña" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>

        <div id="errorMessage" class="text-danger mt-3 text-center"></div>
    </div>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>

    <script>
        $(document).ready(function() {
            $('#loginForm').submit(function(e) {
                e.preventDefault(); // Evita recargar la página

                // Limpiar mensaje de error anterior
                $('#errorMessage').text('');

                // Mostrar carga (opcional)
                var submitBtn = $(this).find('button[type="submit"]');
                var originalText = submitBtn.text();
                submitBtn.text('Ingresando...').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("LoginAjax", "Login")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function(response) {
                        if (response.success) {
                            // IMPORTANTE: Usar la redirectUrl que devuelve el servidor
                            window.location.href = response.redirectUrl;
                        } else {
                            // Muestra mensaje de error
                            $('#errorMessage').text(response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#errorMessage').text("Error de conexión. Intente nuevamente.");
                        console.error("Error en login:", error);
                    },
                    complete: function() {
                        // Restaurar botón
                        submitBtn.text(originalText).prop('disabled', false);
                    }
                });
            });

            // Enter key submit
            $('input').keypress(function(e) {
                if (e.which == 13) {
                    $('#loginForm').submit();
                }
            });
        });
    </script>

</body>
</html>