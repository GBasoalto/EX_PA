@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login - Empresa</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <link href="~/css/login.css" rel="stylesheet" />
</head>
<body>

    <!-- Fondos deslizantes -->
    <div class="bg-slide" style="background-image: url('/images/loginfondo1.jpg');"></div>
    <div class="bg-slide" style="background-image: url('/images/loginfondo2.jpg');"></div>
    <div class="bg-slide" style="background-image: url('/images/loginfondo3.jpg');"></div>
    <div class="bg-slide" style="background-image: url('/images/loginfondo4.jpg');"></div>

    <!-- Card de login -->
    <div class="card login-card">
        <div class="text-center mb-4">
            <img src="~/images/logo.jpeg" alt="Logo Empresa" class="img-fluid login-logo" />
        </div>

        <h3 class="text-center mb-4">Iniciar Sesión</h3>

        <form id="loginForm">
            <div class="mb-3">
                <input name="username" class="form-control" placeholder="Usuario" />
            </div>
            <div class="mb-3">
                <input name="password" type="password" class="form-control" placeholder="Contraseña" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>

        <div id="errorMessage" class="text-danger mt-3 text-center"></div>
    </div>

    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>

    <script>
        $(document).ready(function() {
            $('#loginForm').submit(function(e) {
                e.preventDefault(); // Evita recargar la página

                $.ajax({
                    url: '@Url.Action("LoginAjax", "Login")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function(response) {
                        if (response.success) {
                            // Redirige al home si login correcto
                            window.location.href = '/Home/Index';
                        } else {
                            // Muestra mensaje de error
                            $('#errorMessage').text(response.message);
                        }
                    },
                    error: function() {
                        $('#errorMessage').text("Ocurrió un error al intentar iniciar sesión");
                    }
                });
            });
        });
    </script>

</body>
</html>
